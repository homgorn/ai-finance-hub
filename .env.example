# Development defaults are intentionally unauthenticated.
# Production requires both distinct secrets before the API starts.
AI_FINANCE_HUB_ENVIRONMENT=production
AI_FINANCE_HUB_API_KEY=replace-with-a-long-client-secret
AI_FINANCE_HUB_WORKER_API_KEY=replace-with-a-long-worker-secret

# Only adapters implemented in this repository are accepted.
AI_FINANCE_HUB_IDEMPOTENCY_BACKEND=inmemory
AI_FINANCE_HUB_QUEUE_BACKEND=sqlite
AI_FINANCE_HUB_QUEUE_SQLITE_PATH=.runtime/queue.db
AI_FINANCE_HUB_EVENT_STORE_BACKEND=sqlite
AI_FINANCE_HUB_EVENT_STORE_SQLITE_PATH=.runtime/events.db
